# ============================================================
# Story Engine .env 模板 — 复制为 .env 后填实际值
# ============================================================
# 后端会自动读 story-engine/.env（backend/main.py:_load_dotenv）
# 不装 python-dotenv 依赖，所以不支持引号包裹、不支持 export 前缀、不支持行内注释
# 每行格式必须是：KEY=VALUE，# 开头的整行会被忽略

# ============ 1. 服务运行 ============

# 后端监听端口（默认 8111；命令行 --port 优先级更高）
PORT=8111

# 项目数据目录（存 SQLite + chapters.json）
# 默认：story-engine/data/projects/yupei
# STORY_ENGINE_PROJECT_DIR=

# 前端构建产物目录（单端口生产模式时后端从这里托管 SPA）
# 默认：story-engine/frontend/dist
# STORY_ENGINE_FRONTEND_DIST=

# ============ 2. LLM 调用 ============
# 模式：mock（无 key 跑剧本）/ openai（OpenAI 兼容协议）
STORY_ENGINE_LLM_MODE=openai

# === 选一个 provider 取消注释 ===

# --- Moonshot 开放平台（推荐用于写故事，通用模型按量计费）---
STORY_ENGINE_LLM_BASE_URL=https://api.moonshot.cn/v1
STORY_ENGINE_LLM_API_KEY=sk-在这里填你的 Moonshot key
STORY_ENGINE_LLM_MODEL=kimi-k2.6

# --- Kimi Code 套餐（sk-kimi- 前缀，按周期配额，UA 自动适配）---
# STORY_ENGINE_LLM_BASE_URL=https://api.kimi.com/coding/v1
# STORY_ENGINE_LLM_API_KEY=sk-kimi-在这里填你的 Kimi Code key
# STORY_ENGINE_LLM_MODEL=kimi-for-coding

# --- 智谱 GLM ---
# STORY_ENGINE_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# STORY_ENGINE_LLM_API_KEY=在这里填你的 GLM key
# STORY_ENGINE_LLM_MODEL=glm-4-flash

# --- DeepSeek ---
# STORY_ENGINE_LLM_BASE_URL=https://api.deepseek.com/v1
# STORY_ENGINE_LLM_API_KEY=在这里填你的 DeepSeek key
# STORY_ENGINE_LLM_MODEL=deepseek-chat

# --- OpenAI 官方 ---
# STORY_ENGINE_LLM_BASE_URL=https://api.openai.com/v1
# STORY_ENGINE_LLM_API_KEY=sk-在这里填你的 OpenAI key
# STORY_ENGINE_LLM_MODEL=gpt-4o-mini

# 自定义 User-Agent（仅 Kimi Code 端点要求 Coding-Agent UA；
# 留空且 key 以 sk-kimi- 开头时自动填 claude-code/0.1.0）
# STORY_ENGINE_LLM_USER_AGENT=

# 思考模式：on / off（仅 Kimi Code 端点区分思考/非思考 temperature；
# 其他 provider 不受影响，默认 off 省钱）
# STORY_ENGINE_LLM_THINKING=off

# ============ 3. 题材/文化（三正交轴） ============
# 可选值：story-engine/story_engine/plugins/ 下实际存在的清单
#   genre：mystery / romance / wuxia
#   culture：confucian_officialdom
STORY_ENGINE_GENRE=mystery
STORY_ENGINE_CULTURE=confucian_officialdom

# ============ 4. Embedding（向量检索，Phase 2 起启用） ============
# 本地 bge-small-zh-v1.5（蓝图技术栈），经 HF-Mirror 下载
# 使用 FastEmbed（ONNX Runtime），无需 PyTorch（~30MB vs ~2GB）
# Windows PowerShell 也可临时：$env:HF_ENDPOINT="https://hf-mirror.com"
HF_ENDPOINT=https://hf-mirror.com
STORY_ENGINE_EMBED_MODE=local
# local=FastEmbed 本地推理（ONNX）；dummy=hash 伪向量（测试兜底）
STORY_ENGINE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
STORY_ENGINE_EMBED_DIMENSIONS=512

# ============ 5. 剧本化教学演示 ============
# 1=前 3 章用《玉佩案》剧本（零 API 成本，演示三类违规）
# 0=全程真实 LLM 有机生成（从第 1 章开始就烧 token）
STORY_ENGINE_SCRIPTED_DEMO=1

# ============ 6. Actor 模式（Phase 2） ============
# 单章节 tick 上限（5 角色 × 5 tick = 25 次 LLM propose，封顶防超花）
STORY_ENGINE_ACTOR_MAX_TICKS=5

# ============ 7. 概念整合（Phase 3 决策7，可选灵感） ============
# 每 N 章在决策卡附 1 个跨域 CreativeSeed（每次 1 次额外 LLM 调用 + embedding 比对），
# prompt 渲染为「可选灵感」段（可参考可忽略）；0=关闭（默认），如 3 表示每 3 章一次
STORY_ENGINE_BLEND_EVERY=0

# ============ 8. 自评迭代（Phase 4，仅真实 LLM 模式生效） ============
# 章节自评闭环：ProcessGate → Critic 议会 → Leader 仲裁 → best-of-K 迭代。
# 仅在 STORY_ENGINE_SCRIPTED_DEMO=0 且 LLM 非 mock 时启用；自评是增强不是门禁，
# 自评链路任何异常自动退回未迭代结果，不阻塞章节生成
# 1=开启（默认）；0=关闭
STORY_ENGINE_EVAL_ENABLED=1
# 迭代轮数（默认 3，硬上限 5 防失控）
STORY_ENGINE_EVAL_MAX_ROUNDS=3
# 蓝图要求 critic 模型 ≥ generator；LLMPool.call 暂无 model 参数，
# 本期 critic 与 generator 同模型，此变量为预留配置位（当前不生效）
# STORY_ENGINE_CRITIC_MODEL=

# ============ 9. 人类感注入（Phase 5 决策5，默认关） ============
# 章节 humanize 时按此百分比概率注入 1 处微小瑕疵（蓝图 5-10% 有损质量，故默认 0=关）
STORY_ENGINE_HUMANIZE_FLAW=0

# ============ 10. IR-first 叙事化（Phase 5 决策6，仅真实 LLM 模式生效） ============
# 章节文本产出改经 IRBuilder → Fabula/Sjuzhet → Narrativizer。
# 每章 LLM 调用数如实口径（P5.11 评审修正，原「持平」失实）：
#   直接 LLM 路径：Realizer 1 次替代原 1 次生成，1:1 持平；
#   Actor 路径：原汇总渲染零 LLM 调用 → IR-first +1 次/章；
#   Realizer 故障回退：当章失败调用 + 回退生成，双调用。
# 空稿/异常自动记 warning 并回退旧 prompt 路径，不阻塞章节生成。
# 仅在 STORY_ENGINE_SCRIPTED_DEMO=0 且 LLM 非 mock 时启用
# 1=开启（默认）；0=回退 P3.8 prompt 路径（质量漂移逃生门）
STORY_ENGINE_IR_FIRST=1
